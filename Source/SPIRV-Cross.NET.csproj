<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SPIRV-Cross.NET</PackageId>
    <Version>1.0.3</Version>
    <Authors>Kai Angulo</Authors>
    <Owners>Kai Angulo</Owners>
    <Copyright>Copyright (c) Kai Angulo 2024.</Copyright>
    <Description>A cross-platform managed wrapper for Khronos Group's SPIRV-Cross cross-compiler</Description>
    <RepositoryUrl>https://github.com/sinnwrig/SPIRV-Cross.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>shader compiler spirv SPIRV-Cross crosscompiler hlsl glsl msl metal DirectX Vulkan OpenGL shader-programs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- Native Libraries -->
  <ItemGroup>
    <NativeReference Include="../Native/lib/windows-x64/bin/example.dll" >
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <PackagePath>runtimes/win-x64/native</PackagePath>
    </NativeReference>
    <NativeReference Include="../Native/lib/windows-arm64/bin/example.dll" >
      <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
      <PackagePath>runtimes/win-arm64/native</PackagePath>
    </NativeReference>
    <NativeReference Include="../Native/lib/linux-x64/lib/example.so" >
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <PackagePath>runtimes/linux-x64/native</PackagePath>
    </NativeReference>
    <NativeReference Include="../Native/lib/linux-arm64/lib/example.so" >
      <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
      <PackagePath>runtimes/linux-arm64/native</PackagePath>
    </NativeReference>
    <NativeReference Include="../Native/lib/macos-x64/lib/example.dylib" >
      <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
      <PackagePath>runtimes/osx-x64/native</PackagePath>
    </NativeReference>
    <NativeReference Include="../Native/lib/macos-arm64/lib/example.dylib" >
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <PackagePath>runtimes/osx-arm64/native</PackagePath>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Package license and README -->
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
